38752>>>    End_Procedure
38753>>>
38753>>>    /*Es un evento de la vista y pregunta que quieres hacer al llegar a esa vista. Hay que ponerle el parametro de entrada    de la información que se le está pasando, tienen informacion de la vista que me esta invocando (Integer hoInvokingView)    y tiene la información del objeto que me está invocando (Integer hoInvokingObject).    Analogia -Viaje en tren Malaga a Madrid-: OnNavigateForward=Madrid; hoInvokingView=Malaga; hoInvokingObject=Tren;     tWebNavigateData y NavigateData= Maletas, reserva hotel,...  */
38753>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38756>>>        Case Begin
38756>>>            Case (NavigateData.eNavigateType = nfFromMain)
38758>>>                // If from main, this is a propbably a main file Select to Zoom.
38758>>>                Case Break
38759>>>
38759>>>            Case (NavigateData.eNavigateType = nfFromParent)
38762>>>                // If from parent, this is a constrained drill down.
38762>>>                Case Break
38763>>>
38763>>>            Case (NavigateData.eNavigateType = nfFromChild)
38766>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38766>>>                Case Break
38767>>>
38767>>>            Case Else // must be nfUndefined
38767>>>
38767>>>        Case End
38767>>>
38767>>>        Send SetActionButtons
38768>>>        
38768>>>        /* Esto es lo que se pone por defecto en un zoom: Si he venido al zoomEntrenador, seleccionando un entrenador ponme el nombre,         si no hay un record es que vienes de viewnewrecord por lo tanto pon Nuevo entrenador */
38768>>>        If (HasRecord(Server(Self))) Begin
38770>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
38771>>>            Send SetBreadcrumbCaption entrenador.Nombre
38772>>>        End
38772>>>>
38772>>>        Else Begin
38773>>>            Send SetHeaderCaption   "Nuevo entrenador"
38774>>>            Send SetBreadcrumbCaption "Nuevo"
38775>>>        End 
38775>>>>
38775>>>    End_Procedure
38776>>>
38776>>>End_Object 
