37613>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37616>>>        Case Begin
37616>>>            Case (NavigateData.eNavigateType = nfFromMain)
37618>>>                // If from main, this is a propbably a main file Select to Zoom.
37618>>>                Case Break
37619>>>
37619>>>            Case (NavigateData.eNavigateType = nfFromParent)
37622>>>                // If from parent, this is a constrained drill down.
37622>>>                Case Break
37623>>>
37623>>>            Case (NavigateData.eNavigateType = nfFromChild)
37626>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37626>>>                Case Break
37627>>>
37627>>>            Case Else // must be nfUndefined
37627>>>
37627>>>        Case End
37627>>>
37627>>>        Send SetActionButtons
37628>>>
37628>>>    End_Procedure
