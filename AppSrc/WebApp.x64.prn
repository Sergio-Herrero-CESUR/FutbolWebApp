38735>>>        If (NavigateData.bReadOnly) Begin
38737>>>            WebSet pbRender of oEditBtn to True
38738>>>        End
38738>>>>
38738>>>        Else Begin
38739>>>            WebSet pbRender of oSaveBtn to True
38740>>>            WebSet pbRender of oCancelChangesBtn to True
