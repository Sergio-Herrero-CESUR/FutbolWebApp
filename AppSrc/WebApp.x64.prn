38254>>>>>                // If from parent, this is a constrained drill down.
38254>>>>>                Case Break
38255>>>>>
38255>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38258>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38258>>>>>                Case Break
38259>>>>>
38259>>>>>            Case Else // must be nfUndefined
38259>>>>>
38259>>>>>        Case End
