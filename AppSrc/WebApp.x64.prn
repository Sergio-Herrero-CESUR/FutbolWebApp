38021>>>>>        tWebNavigateData NavigateData
38021>>>>>        tWebNavigateData NavigateData
38021>>>>>        Boolean bHasRecord
38021>>>>>        Handle hoDD
38021>>>>>
38021>>>>>        Get Server to hoDD
38022>>>>>        Get GetNavigateData to NavigateData
38023>>>>>        Get HasRecord of hoDD to bHasRecord
38024>>>>>
38024>>>>>        // let's hide all buttons and then Show the ones we want
38024>>>>>        WebSet pbRender of oEditBtn to False
38025>>>>>        WebSet pbRender of oSaveBtn to False
38026>>>>>        WebSet pbRender of oCancelChangesBtn to False
38027>>>>>        WebSet pbRender of oDeleteBtn to False
38028>>>>>
38028>>>>>        If (NavigateData.bReadOnly) Begin
38030>>>>>            WebSet pbRender of oEditBtn to True
38031>>>>>        End
38031>>>>>>
38031>>>>>        Else Begin
38032>>>>>            WebSet pbRender of oSaveBtn to True
38033>>>>>            WebSet pbRender of oCancelChangesBtn to True
38034>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38035>>>>>        End
38035>>>>>>
38035>>>>>    End_Procedure
