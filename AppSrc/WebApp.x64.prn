37912>>>                // If from parent, this is a constrained drill down.
37912>>>                Case Break
37913>>>
37913>>>            Case (NavigateData.eNavigateType = nfFromChild)
37916>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37916>>>                Case Break
37917>>>
37917>>>            Case Else // must be nfUndefined
37917>>>
37917>>>        Case End
37917>>>
37917>>>        Send SetActionButtons
37918>>>
37918>>>    End_Procedure
37919>>>
37919>>>End_Object 
