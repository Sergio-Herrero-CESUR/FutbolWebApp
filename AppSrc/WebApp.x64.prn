37946>>>    Object oSubidaFicherosArrastre is a cWebDragDropFileHelper
37948>>>        
37948>>>        // Register drop targgets
37948>>>        Send RegisterDropTarget oSubirFicheros C_WebDropOnControl
37949>>>        Send RegisterDropTarget oSubirFicherosBlack C_WebDropOnControl
37950>>>        
37950>>>        // Set psAccept to ".pdf"
37950>>>        
37950>>>        // Called for each file dropped, should return the local path to write the file
37950>>>        Function OnFileDrop String sFileName Integer iBytes String sMime Handle hoDropTarget WebDropPosition eDropPosition Returns String
37953>>>            String sPath sCarpeta
37953>>>            Boolean bExist
37953>>>            
37953>>>            Forward Get OnFileDrop sFileName iBytes sMime hoDropTarget eDropPosition to sPath
37955>>>            
37955>>>            If (hoDropTarget = oSubirFicheros) Begin
37957>>>                Move "aBlanco" to sCarpeta
37958>>>            End
37958>>>>
37958>>>            Else Begin
37959>>>                Move "aNegro" to sCarpeta
37960>>>            End
37960>>>>
37960>>>            
37960>>>            Get ObtainPath sCarpeta to sPath
37961>>>            
37961>>>            Move (sPath + "\" + sFileName) to sPath
37962>>>            
37962>>>            //Check if we are not overwriting an existing file
37962>>>            File_Exist sPath bExist
37963>>>            //Existe
37963>>>            Case Begin
37963>>>                Case (bExist)
37965>>>                    Send UserError "Ya existe un archivo con ese nombre."
37966>>>                    Function_Return ""
37967>>>                    Case Break
37968>>>            //PDF        
37968>>>                Case (not (sMime = "application/pdf"))
37971>>>                    Send UserError "Solo se permiten archivos pdf"
37972>>>                    Function_Return ""
37973>>>                    Case Break  
37974>>>            // 100000 m        
37974>>>                Case (iBytes > 1000000)
37977>>>                    Send UserError "Archivo demasiado pesado"
37978>>>                    Function_Return ""
37979>>>                    Case Break
37980>>>                    
37980>>>                Case Else
37980>>>                    Function_Return sPath                  
37981>>>            Case End
37981>>>            
37981>>>        End_Function
37982>>>    End_Object
