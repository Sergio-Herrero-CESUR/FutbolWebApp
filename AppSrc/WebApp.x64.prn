39091>>>    Procedure SetActionButtons
39094>>>        tWebNavigateData NavigateData
39094>>>        tWebNavigateData NavigateData
39094>>>        Boolean bHasRecord
39094>>>        Handle hoDD
39094>>>
39094>>>        Get Server to hoDD
39095>>>        Get GetNavigateData to NavigateData
39096>>>        Get HasRecord of hoDD to bHasRecord
39097>>>
39097>>>        // let's hide all buttons and then Show the ones we want
39097>>>        WebSet pbRender of oEditBtn to False
39098>>>        WebSet pbRender of oSaveBtn to False
39099>>>        WebSet pbRender of oCancelChangesBtn to False
39100>>>        WebSet pbRender of oDeleteBtn to False
39101>>>
39101>>>        If (NavigateData.bReadOnly) Begin
39103>>>            WebSet pbRender of oEditBtn to True
39104>>>        End
39104>>>>
39104>>>        Else Begin
39105>>>            WebSet pbRender of oSaveBtn to True
39106>>>            WebSet pbRender of oCancelChangesBtn to True
39107>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39108>>>        End
39108>>>>
39108>>>    End_Procedure
39109>>>
39109>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
39112>>>        // Close after save
39112>>>        Send NavigateClose Self
39113>>>    End_Procedure
39114>>>
39114>>>    // this will close the view after a delete
39114>>>    Procedure OnViewDeleted Handle hoDDO
39117>>>        Send NavigateClose Self
39118>>>    End_Procedure
39119>>>
39119>>>    /*Es un evento de la vista y pregunta que quieres hacer al llegar a esa vista. Hay que ponerle el parametro de entrada    de la información que se le está pasando, tienen informacion de la vista que me esta invocando (Integer hoInvokingView)    y tiene la información del objeto que me está invocando (Integer hoInvokingObject).    Analogia -Viaje en tren Malaga a Madrid-: OnNavigateForward=Madrid; hoInvokingView=Malaga; hoInvokingObject=Tren;     tWebNavigateData y NavigateData= Maletas, reserva hotel,...  */
39119>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39122>>>        Case Begin
39122>>>            Case (NavigateData.eNavigateType = nfFromMain)
39124>>>                // If from main, this is a propbably a main file Select to Zoom.
39124>>>                Case Break
39125>>>
39125>>>            Case (NavigateData.eNavigateType = nfFromParent)
39128>>>                // If from parent, this is a constrained drill down.
39128>>>                Case Break
39129>>>
39129>>>            Case (NavigateData.eNavigateType = nfFromChild)
39132>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39132>>>                Case Break
39133>>>
39133>>>            Case Else // must be nfUndefined
39133>>>
39133>>>        Case End
39133>>>
39133>>>        Send SetActionButtons
39134>>>        
39134>>>        /* Esto es lo que se pone por defecto en un zoom: Si he venido al zoomEntrenador, seleccionando un entrenador ponme el nombre,         si no hay un record es que vienes de viewnewrecord por lo tanto pon Nuevo entrenador */
39134>>>        If (HasRecord(Server(Self))) Begin
39136>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
39137>>>            Send SetBreadcrumbCaption entrenador.Nombre
39138>>>        End
39138>>>>
39138>>>        Else Begin
39139>>>            Send SetHeaderCaption   "Nuevo entrenador"
39140>>>            Send SetBreadcrumbCaption "Nuevo"
39141>>>        End 
39141>>>>
39141>>>    End_Procedure
39142>>>
39142>>>End_Object 
