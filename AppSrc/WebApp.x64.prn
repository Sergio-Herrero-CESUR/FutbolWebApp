38429>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38432>>>        Case Begin
38432>>>            Case (NavigateData.eNavigateType = nfFromMain)
38434>>>                // If from main, this is a propbably a main file Select to Zoom.
38434>>>                Case Break
38435>>>
38435>>>            Case (NavigateData.eNavigateType = nfFromParent)
38438>>>                // If from parent, this is a constrained drill down.
38438>>>                Case Break
38439>>>
38439>>>            Case (NavigateData.eNavigateType = nfFromChild)
38442>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38442>>>                Case Break
38443>>>
38443>>>            Case Else // must be nfUndefined
38443>>>
38443>>>        Case End
38443>>>
38443>>>        Send SetActionButtons
38444>>>
38444>>>    End_Procedure
38445>>>
38445>>>End_Object 
