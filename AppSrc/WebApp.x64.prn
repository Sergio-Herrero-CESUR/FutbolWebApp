37875>>>    Procedure SetActionButtons
37878>>>        tWebNavigateData NavigateData
37878>>>        tWebNavigateData NavigateData
37878>>>        Boolean bHasRecord
37878>>>        Handle hoDD
37878>>>
37878>>>        Get Server to hoDD
37879>>>        Get GetNavigateData to NavigateData
37880>>>        Get HasRecord of hoDD to bHasRecord
37881>>>
37881>>>        // let's hide all buttons and then Show the ones we want
37881>>>        WebSet pbRender of oEditBtn to False
37882>>>        WebSet pbRender of oSaveBtn to False
37883>>>        WebSet pbRender of oCancelChangesBtn to False
37884>>>        WebSet pbRender of oDeleteBtn to False
37885>>>
37885>>>        If (NavigateData.bReadOnly) Begin
37887>>>            WebSet pbRender of oEditBtn to True
37888>>>        End
37888>>>>
37888>>>        Else Begin
37889>>>            WebSet pbRender of oSaveBtn to True
37890>>>            WebSet pbRender of oCancelChangesBtn to True
37891>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37892>>>        End
37892>>>>
37892>>>    End_Procedure
