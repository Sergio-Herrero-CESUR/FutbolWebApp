37994>>>            Function OnFileUpload String sFileName BigInt iBytes String sMime Returns String
37997>>>                String sPath sCarpeta
37997>>>                Boolean bOk
37997>>>                //--------
37997>>>                Get ObtainPath sCarpeta to sPath
37998>>>                Send Info_Box sPath "Ruta Upload"
37999>>>                //---------
37999>>>                Forward Get OnFileUpload sFileName iBytes sMime to sPath
38001>>>                
38001>>>                Move "aBoton" to sCarpeta
38002>>>                
38002>>>                // Determine local parh based on workspace setting
38002>>>                Get ObtainPath sCarpeta to sPath
38003>>>                Move (sPath + "\" + sFileName) to sPath
38004>>>                
38004>>>                File_Exist sPath bOk
38005>>>                
38005>>>                Case Begin
38005>>>                    Case (bOk)
38007>>>                        Send UserError "Ya existe un archivo con ese nombre"
38008>>>                        Function_Return ""
38009>>>                        Case Break
38010>>>                    
38010>>>                    Case (not(sMime = "application/pdf"))
38013>>>                        Send UserError "Solo se permiten archivos PDF"
38014>>>                        Function_Return ""
38015>>>                        Case Break
38016>>>                    
38016>>>                    Case (iBytes > 1000000)
38019>>>                        Send UserError "Archivo demasiado pesado"
38020>>>                        Function_Return ""
38021>>>                        Case Break
38022>>>                    
38022>>>                    Case Else
38022>>>                        Function_Return sPath
38023>>>                Case End
38023>>>                
38023>>>            End_Function
