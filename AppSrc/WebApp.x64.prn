37605>>>                Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject 
37608>>>                    Case Begin
37608>>>                    Case (NavigateData.eNavigateType = nfFromParent)
37610>>>                        // If from parent, this is a constrained drill down
37610>>>                        Case Break
37611>>>                    Case (NavigateData.eNavigateType = nfFromChild)
37614>>>                        // If from child, this is a probably a parent lookup from a Zoom
37614>>>                        Case Break
37615>>>                    Case (NavigateData.eNavigateType = nfFromMain)
37618>>>                        // If from main, this is a probably a main-file lookup from a Zoom               
37618>>>                        Case Break
37619>>>                    Case Else // must be nfUndefined
37619>>>                        // This may be the start of a drilldown query or this may be used for some kind of custom query.
37619>>>                    Case End
37619>>>                End_Procedure   
