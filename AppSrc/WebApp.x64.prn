38401>>>    Procedure SetActionButtons
38404>>>        tWebNavigateData NavigateData
38404>>>        tWebNavigateData NavigateData
38404>>>        Boolean bHasRecord
38404>>>        Handle hoDD
38404>>>
38404>>>        Get Server to hoDD
38405>>>        Get GetNavigateData to NavigateData
38406>>>        Get HasRecord of hoDD to bHasRecord
38407>>>
38407>>>        // let's hide all buttons and then Show the ones we want
38407>>>        WebSet pbRender of oEditBtn to False
38408>>>        WebSet pbRender of oSaveBtn to False
38409>>>        WebSet pbRender of oCancelChangesBtn to False
38410>>>        WebSet pbRender of oDeleteBtn to False
38411>>>
38411>>>        If (NavigateData.bReadOnly) Begin
38413>>>            WebSet pbRender of oEditBtn to True
38414>>>        End
38414>>>>
38414>>>        Else Begin
38415>>>            WebSet pbRender of oSaveBtn to True
38416>>>            WebSet pbRender of oCancelChangesBtn to True
38417>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38418>>>        End
38418>>>>
38418>>>    End_Procedure
