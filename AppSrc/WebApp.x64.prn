38355>>>                Case (NavigateData.eNavigateType = nfFromMain)
38358>>>                    Send NavigateClose Self
38359>>>                    Case Break
38360>>>
38360>>>                Case Else // must be nfUndefined
38360>>>                    Send NavigateForward of oSelectLiga Self //Liga(Padre)
38361>>>
38361>>>            Case End
