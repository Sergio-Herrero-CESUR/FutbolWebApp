38076>>>    Function ObtainPath String sDir Returns String
38079>>>        String sPath
38079>>>        String[] saFolders
38080>>>        Integer iCount
38080>>>        
38080>>>        Get UploadFolder of ghoWebApp False to sPath
38081>>>        
38081>>>        Move (StrSplitToArray(sPath, "\")) to saFolders
38082>>>        Move (SizeOfArray(saFolders)-1) to iCount
38083>>>        Move sDir to saFolders[iCount]
38084>>>        Move (StrJoinFromArray(saFolders, "\")) to sPath
38085>>>        
38085>>>        Function_Return sPath
38086>>>    End_Function
38087>>>    
38087>>>    /*    Function ObtainPath String sDir Returns String        String sPath            Get UploadFolder of ghoWebApp False to sPath        Move (sPath + "\" + sDir) to sPath            Function_Return sPath    End_Function    */
