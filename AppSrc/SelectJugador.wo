Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use ZoomJugador.wo

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd

Object oSelectJugador is a cWebView
    Set psCaption to "Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To ojugador_DD
    Set Server  To ojugador_DD


    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to False
        Set piSortColumn to 0

        Object ojugadorNombre is a cWebColumn
            Entry_Item jugador.Nombre
            Set psCaption to "jugador.Nombre"
            Set piWidth to 600
        End_Object 

        Object ojugadorApellido is a cWebColumn
            Entry_Item jugador.Apellido
            Set psCaption to "jugador.Apellido"
            Set piWidth to 600
        End_Object 

        Object oDetailButton is a cWebColumnButton
            Set psCaption to "btn"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 2
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

            WebRegisterPath ntNavigateForward oZoomJugador

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
            End_Procedure

            Procedure AllowFillDEO Boolean  ByRef bAllow
                Forward Send AllowFillDEO (&bAllow)
            End_Procedure

            Procedure AllowServerAction Boolean  ByRef bAllow String sMethodName Handle hoMessage Boolean bIsFunction
                Forward Send AllowServerAction (&bAllow) sMethodName hoMessage bIsFunction
            End_Procedure

            Procedure AllowUpdateDD Boolean  ByRef bAllow
                Forward Send AllowUpdateDD (&bAllow)
            End_Procedure

            Procedure Destroy_Object
                Forward Send Destroy_Object
            End_Procedure

            Procedure OnAutoFind
                Forward Send OnAutoFind
            End_Procedure

            Procedure OnBlur
                Forward Send OnBlur
            End_Procedure

            Procedure OnCallEnd
                Forward Send OnCallEnd
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Forward Send OnChange sNewValue sOldValue
            End_Procedure

            Procedure OnCloseModalDialog Handle hoModalDialog
                Forward Send OnCloseModalDialog hoModalDialog
            End_Procedure

            Procedure OnDefineButtons
                Forward Send OnDefineButtons
            End_Procedure

            Procedure OnFocus
                Forward Send OnFocus
            End_Procedure

            Procedure OnGetNavigateBackData tWebNavigateData  ByRef NavigateData Handle hoBackToView
                Forward Send OnGetNavigateBackData (&NavigateData) hoBackToView
            End_Procedure

            Procedure OnHeaderClick
                Forward Send OnHeaderClick
            End_Procedure

            Procedure OnLoad
                Forward Send OnLoad
            End_Procedure

            Procedure OnNavigateBack Handle hoCallback tWebNavigateData NavigateData
                Forward Send OnNavigateBack hoCallback NavigateData
            End_Procedure

            Procedure OnSetCalculatedValue String  ByRef sValue
                Forward Send OnSetCalculatedValue (&sValue)
            End_Procedure

            Function OnValidate Returns Boolean
                Boolean bRetVal
                Forward Get OnValidate to bRetVal
                
                Function_Return bRetVal
            End_Function

            Procedure Prompt_Callback Handle hoPrompt
                Forward Send Prompt_Callback hoPrompt
            End_Procedure

            Procedure Refresh Integer eMode
                Forward Send Refresh eMode
            End_Procedure

        End_Object 

        Object ojugadorNacionalidad is a cWebColumn
            Entry_Item jugador.Nacionalidad
            Set psCaption to "jugador.Nacionalidad"
            Set piWidth to 500
            Set pbNewLine to True
        End_Object 

        Object oequipoNombre is a cWebColumn
            Entry_Item equipo.Nombre
            Set psCaption to "equipo.Nombre"
            Set piWidth to 1201
        End_Object 

// ToDo: Fill in the from-parent child Select view object name for navigate forward
//        WebRegisterPath ntNavigateForward oSelectView

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
// ToDo: Fill in the from-parent child Select view object name for navigate forward
Error DFERR_PROGRAM "NavigateForward to this from-parent child Select view not yet defined"
//                    Send NavigateForward of oSelectView Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    Send NavigateClose Self
                    Case Break

                Case Else // must be nfUndefined
// ToDo: Fill in the from-parent child Select view object name for navigate forward
Error DFERR_PROGRAM "NavigateForward to this from-parent child Select view not yet defined"
//                    Send NavigateForward of oSelectView Self

            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

            WebRegisterPath ntNavigateForward oZoomJugador

            Procedure OnClick
                Send NavigatePath
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent lookup from a Zoom
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a probably a main-file lookup from a Zoom
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // This may be the start of a drilldown query or this may be used for some kind of custom query.

        Case End

    End_Procedure

